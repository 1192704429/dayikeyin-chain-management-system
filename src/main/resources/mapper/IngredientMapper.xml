<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dake.catering.module.ingredient.mapper.IngredientMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND ingredient.id = #{entity.id}
            </if>
            <if test="entity.ingredientName != null and entity.ingredientName != ''">
                AND ingredient.ingredient_name LIKE CONCAT('%', #{entity.ingredientName}, '%')
            </if>
            <if test="entity.unit != null and entity.unit != ''">
                AND ingredient.unit = #{entity.unit}
            </if>
            <if test="entity.status != null">
                AND ingredient.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.dake.catering.module.ingredient.entity.Ingredient">
        SELECT ingredient.*
        FROM ingredient ingredient
        <include refid="whereCondition"/>
        ORDER BY ingredient.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM ingredient ingredient
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.dake.catering.module.ingredient.entity.Ingredient">
        SELECT ingredient.*
        FROM ingredient ingredient
        <include refid="whereCondition"/>
        ORDER BY ingredient.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.dake.catering.module.ingredient.entity.Ingredient">
        SELECT ingredient.*
        FROM ingredient ingredient
        WHERE ingredient.id = #{id}
    </select>

</mapper>

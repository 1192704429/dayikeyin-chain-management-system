<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dake.catering.module.sys_store.mapper.SysStoreMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND sysStore.id = #{entity.id}
            </if>
            <if test="entity.storeName != null and entity.storeName != ''">
                AND sysStore.store_name LIKE CONCAT('%', #{entity.storeName}, '%')
            </if>
            <if test="entity.storeNo != null and entity.storeNo != ''">
                AND sysStore.store_no LIKE CONCAT('%', #{entity.storeNo}, '%')
            </if>
            <if test="entity.contactPhone != null and entity.contactPhone != ''">
                AND sysStore.contact_phone LIKE CONCAT('%', #{entity.contactPhone}, '%')
            </if>
            <if test="entity.businessStatus != null">
                AND sysStore.business_status = #{entity.businessStatus}
            </if>
            <if test="entity.taxRegisterNo != null and entity.taxRegisterNo != ''">
                AND sysStore.tax_register_no LIKE CONCAT('%', #{entity.taxRegisterNo}, '%')
            </if>
            <if test="entity.status != null">
                AND sysStore.status = #{entity.status}
            </if>
            <if test="entity.realName != null and entity.realName != ''">
                AND userInfo.real_name LIKE CONCAT('%', #{entity.realName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.dake.catering.module.sys_store.entity.SysStore">
        SELECT sysStore.*
        , userInfo.real_name AS realName
        FROM sys_store sysStore
        LEFT JOIN user_info userInfo ON sysStore.manager_id = userInfo.id
        <include refid="whereCondition"/>
        ORDER BY sysStore.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM sys_store sysStore
        LEFT JOIN user_info userInfo ON sysStore.manager_id = userInfo.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.dake.catering.module.sys_store.entity.SysStore">
        SELECT sysStore.*
        , userInfo.real_name AS realName
        FROM sys_store sysStore
        LEFT JOIN user_info userInfo ON sysStore.manager_id = userInfo.id
        <include refid="whereCondition"/>
        ORDER BY sysStore.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.dake.catering.module.sys_store.entity.SysStore">
        SELECT sysStore.*
        , userInfo.real_name AS realName
        FROM sys_store sysStore
        LEFT JOIN user_info userInfo ON sysStore.manager_id = userInfo.id
        WHERE sysStore.id = #{id}
    </select>

</mapper>

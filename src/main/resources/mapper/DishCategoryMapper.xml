<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dake.catering.module.dish_category.mapper.DishCategoryMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND dishCategory.id = #{entity.id}
            </if>
            <if test="entity.categoryName != null and entity.categoryName != ''">
                AND dishCategory.category_name LIKE CONCAT('%', #{entity.categoryName}, '%')
            </if>
            <if test="entity.categoryNo != null and entity.categoryNo != ''">
                AND dishCategory.category_no LIKE CONCAT('%', #{entity.categoryNo}, '%')
            </if>
            <if test="entity.status != null">
                AND dishCategory.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.dake.catering.module.dish_category.entity.DishCategory">
        SELECT dishCategory.*
        FROM dish_category dishCategory
        <include refid="whereCondition"/>
        ORDER BY dishCategory.`sort`,dishCategory.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM dish_category dishCategory
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.dake.catering.module.dish_category.entity.DishCategory">
        SELECT dishCategory.*
        FROM dish_category dishCategory
        <include refid="whereCondition"/>
        ORDER BY dishCategory.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.dake.catering.module.dish_category.entity.DishCategory">
        SELECT dishCategory.*
        FROM dish_category dishCategory
        WHERE dishCategory.id = #{id}
    </select>

</mapper>

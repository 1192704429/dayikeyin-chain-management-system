<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dake.catering.module.dish_info.mapper.DishInfoMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND dishInfo.id = #{entity.id}
            </if>
            <if test="entity.dishName != null and entity.dishName != ''">
                AND dishInfo.dish_name LIKE CONCAT('%', #{entity.dishName}, '%')
            </if>
            <if test="entity.flavor != null">
                AND dishInfo.flavor = #{entity.flavor}
            </if>
            <if test="entity.isSpicy != null">
                AND dishInfo.is_spicy = #{entity.isSpicy}
            </if>
            <if test="entity.isVegetarian != null">
                AND dishInfo.is_vegetarian = #{entity.isVegetarian}
            </if>
            <if test="entity.status != null">
                AND dishInfo.status = #{entity.status}
            </if>
            <if test="entity.categoryName != null and entity.categoryName != ''">
                AND dishCategory.category_name LIKE CONCAT('%', #{entity.categoryName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.dake.catering.module.dish_info.entity.DishInfo">
        SELECT dishInfo.*
        , dishCategory.category_name AS categoryName
        FROM dish_info dishInfo
        LEFT JOIN dish_category dishCategory ON dishInfo.category_id = dishCategory.id
        <include refid="whereCondition"/>
        ORDER BY dishInfo.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM dish_info dishInfo
        LEFT JOIN dish_category dishCategory ON dishInfo.category_id = dishCategory.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.dake.catering.module.dish_info.entity.DishInfo">
        SELECT dishInfo.*
        , dishCategory.category_name AS categoryName
        FROM dish_info dishInfo
        LEFT JOIN dish_category dishCategory ON dishInfo.category_id = dishCategory.id
        <include refid="whereCondition"/>
        ORDER BY dishInfo.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.dake.catering.module.dish_info.entity.DishInfo">
        SELECT dishInfo.*
        , dishCategory.category_name AS categoryName
        FROM dish_info dishInfo
        LEFT JOIN dish_category dishCategory ON dishInfo.category_id = dishCategory.id
        WHERE dishInfo.id = #{id}
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dake.catering.module.user_info.mapper.UserInfoMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND userInfo.id = #{entity.id}
            </if>
            <if test="entity.username != null and entity.username != ''">
                AND userInfo.username LIKE CONCAT('%', #{entity.username}, '%')
            </if>
            <if test="entity.realName != null and entity.realName != ''">
                AND userInfo.real_name LIKE CONCAT('%', #{entity.realName}, '%')
            </if>
            <if test="entity.roleType != null and entity.roleType != ''">
                AND userInfo.role_type = #{entity.roleType}
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                AND userInfo.phone LIKE CONCAT('%', #{entity.phone}, '%')
            </if>
            <if test="entity.sex != null">
                AND userInfo.sex = #{entity.sex}
            </if>
            <if test="entity.idCard != null and entity.idCard != ''">
                AND userInfo.id_card LIKE CONCAT('%', #{entity.idCard}, '%')
            </if>
            <if test="entity.email != null and entity.email != ''">
                AND userInfo.email LIKE CONCAT('%', #{entity.email}, '%')
            </if>
            <if test="entity.status != null">
                AND userInfo.status = #{entity.status}
            </if>
            <if test="entity.storeId != null">
                AND userInfo.store_id = #{entity.storeId}
            </if>
            <if test="entity.storeName != null and entity.storeName != ''">
                AND sysStore.store_name LIKE CONCAT('%', #{entity.storeName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.dake.catering.module.user_info.entity.UserInfo">
        SELECT userInfo.*
        , sysStore.store_name AS storeName
        FROM user_info userInfo
        LEFT JOIN sys_store sysStore ON userInfo.store_id = sysStore.id
        <include refid="whereCondition"/>
        ORDER BY userInfo.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM user_info userInfo
        LEFT JOIN sys_store sysStore ON userInfo.store_id = sysStore.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.dake.catering.module.user_info.entity.UserInfo">
        SELECT userInfo.*
        , sysStore.store_name AS storeName
        FROM user_info userInfo
        LEFT JOIN sys_store sysStore ON userInfo.store_id = sysStore.id
        <include refid="whereCondition"/>
        ORDER BY userInfo.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.dake.catering.module.user_info.entity.UserInfo">
        SELECT userInfo.*
        , sysStore.store_name AS storeName
        FROM user_info userInfo
        LEFT JOIN sys_store sysStore ON userInfo.store_id = sysStore.id
        WHERE userInfo.id = #{id}
    </select>

</mapper>
